{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepmemo.org/schemas/v1.0/deepmemo.json",
  "title": "DeepMemo Data Structure",
  "description": "JSON Schema for DeepMemo data format (v1.0)",
  "oneOf": [
    { "$ref": "#/$defs/globalExport" },
    { "$ref": "#/$defs/branchExport" }
  ],
  "$defs": {
    "globalExport": {
      "type": "object",
      "description": "Global export containing all data",
      "required": ["nodes", "rootNodes"],
      "properties": {
        "nodes": {
          "type": "object",
          "description": "Dictionary of all nodes, keyed by node ID",
          "patternProperties": {
            "^(node|symlink)_\\d+_[a-z0-9]+$": {
              "$ref": "#/$defs/node"
            }
          },
          "additionalProperties": false
        },
        "rootNodes": {
          "type": "array",
          "description": "Array of root-level node IDs",
          "items": {
            "type": "string",
            "pattern": "^(node|symlink)_\\d+_[a-z0-9]+$"
          }
        }
      },
      "additionalProperties": false
    },
    "branchExport": {
      "type": "object",
      "description": "Branch export containing a subtree",
      "required": ["type", "version", "branchRootId", "exported", "nodeCount", "nodes"],
      "properties": {
        "type": {
          "type": "string",
          "const": "deepmemo-branch",
          "description": "Format type identifier"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "Format version (e.g., '1.0')"
        },
        "branchRootId": {
          "type": "string",
          "pattern": "^(node|symlink)_\\d+_[a-z0-9]+$",
          "description": "ID of the root node of this branch"
        },
        "exported": {
          "type": "integer",
          "minimum": 0,
          "description": "Export timestamp (Unix milliseconds)"
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of nodes in this branch"
        },
        "nodes": {
          "type": "object",
          "description": "Dictionary of branch nodes, keyed by node ID",
          "patternProperties": {
            "^(node|symlink)_\\d+_[a-z0-9]+$": {
              "$ref": "#/$defs/node"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "description": "A DeepMemo node (note or symlink)",
      "required": ["id", "title", "type", "parent", "children", "created", "modified"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(node|symlink)_\\d+_[a-z0-9]+$",
          "description": "Unique node identifier (node_timestamp_random or symlink_timestamp_random)"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Node title/name (can include emojis)"
        },
        "content": {
          "type": "string",
          "description": "Markdown content (optional, empty string if none)"
        },
        "type": {
          "type": "string",
          "enum": ["node", "symlink"],
          "description": "Node type: 'node' for regular nodes, 'symlink' for links to other nodes"
        },
        "parent": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^(node|symlink)_\\d+_[a-z0-9]+$"
            }
          ],
          "description": "Parent node ID, or null for root nodes"
        },
        "children": {
          "type": "array",
          "description": "Array of child node IDs",
          "items": {
            "type": "string",
            "pattern": "^(node|symlink)_\\d+_[a-z0-9]+$"
          }
        },
        "tags": {
          "type": "array",
          "description": "Array of tag strings (optional)",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attachments": {
          "type": "array",
          "description": "Array of attachment metadata objects (optional)",
          "items": {
            "$ref": "#/$defs/attachment"
          }
        },
        "created": {
          "type": "integer",
          "minimum": 0,
          "description": "Creation timestamp (Unix milliseconds)"
        },
        "modified": {
          "type": "integer",
          "minimum": 0,
          "description": "Last modification timestamp (Unix milliseconds)"
        },
        "targetId": {
          "type": "string",
          "pattern": "^(node|symlink)_\\d+_[a-z0-9]+$",
          "description": "Target node ID (required for symlinks only)"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "symlink" } }
          },
          "then": {
            "required": ["targetId"],
            "description": "Symlinks must have a targetId"
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "node" } }
          },
          "then": {
            "not": {
              "required": ["targetId"]
            },
            "description": "Regular nodes cannot have a targetId"
          }
        }
      ],
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "description": "Attachment metadata (actual file stored in attachments/ folder)",
      "required": ["id", "name", "type", "size"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^attach_\\d+_[a-z0-9]+$",
          "description": "Unique attachment identifier (attach_timestamp_random)"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Original filename with extension"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "MIME type (e.g., 'image/png', 'application/pdf')"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "File size in bytes"
        }
      },
      "additionalProperties": false
    }
  }
}
