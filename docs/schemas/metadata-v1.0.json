{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepmemo.org/schemas/v1.0/metadata.json",
  "title": "DeepMemo Archive Metadata",
  "description": "JSON Schema for metadata.json file in .dm archives",
  "type": "object",
  "required": ["version", "type", "exported"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Format version (e.g., '1.0')"
    },
    "type": {
      "type": "string",
      "enum": ["global", "branch"],
      "description": "Export type: 'global' for complete export, 'branch' for subtree"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable export title (usually root node title for branches)"
    },
    "exported": {
      "type": "integer",
      "minimum": 0,
      "description": "Export timestamp (Unix milliseconds)"
    },
    "branchRootId": {
      "type": "string",
      "pattern": "^(node|symlink)_\\d+_[a-z0-9]+$",
      "description": "ID of the branch root node (required for branch exports)"
    },
    "nodeCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Total number of nodes in this export"
    },
    "attachmentCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of attachment files"
    },
    "totalSize": {
      "type": "integer",
      "minimum": 0,
      "description": "Total size of all attachments in bytes"
    },
    "generator": {
      "type": "string",
      "description": "Software that generated this export (e.g., 'DeepMemo v0.10.4')"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "branch" } }
      },
      "then": {
        "required": ["branchRootId"],
        "description": "Branch exports must specify branchRootId"
      }
    }
  ],
  "additionalProperties": false
}
